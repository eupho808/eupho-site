    <effect id="eff_clock_id" name="eff_clock">
      <profile_COMMON>
        <newparam sid="img_surface">
          <surface type="2D">
            <init_from>d01_obj_t_id</init_from>
            <format>PNG</format>
          </surface>
        </newparam>
        <newparam sid="img_sampler">
          <sampler2D>
            <source>img_surface</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
            <minfilter>NONE</minfilter>
            <magfilter>LINEAR</magfilter>
            <mipfilter>LINEAR</mipfilter>
          </sampler2D>
        </newparam>
        <technique sid="img_technique">
          <phong>
            <emission>
              <color>0 0 0 1</color>
            </emission>
            <ambient>
              <color>0 0 0 1</color>
            </ambient>
            <diffuse>
              <texture texture="img_sampler" texcoord="uv" />
            </diffuse>
            <specular>
              <color>1 1 1 1</color>
            </specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
